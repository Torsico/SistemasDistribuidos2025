<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>unguentos</title>
	<!-- <link rel="stylesheet" href="stylesheet.css"> -->
</head>
<body>
	
	<%= render "shared/navbar" %>
	
	<%= render "shared/notif" %>
	
	<div>
		<%= case @style
			when :alta; "Creando"
			when :mod; "Modificando"
			when :baja; "Confirmar baja de"
			else "???????????????"
			end %> evento <%="?" if @style==:baja%>
	</div>
	
	<% if $session.can_mod_events? then %>
	
	<form
		autocomplete="off"
		method="post"
		<% case @style %>
		<% when :alta %>
			action="alta"
		<% when :mod, :baja %>
			action="<%=@editee.ideventos%>"
		<% end %>
	>
	<div class="centermini" style="display: flex;">
		<ul>
			<%if @style == :baja %>
				<%=@editee.nombre%>
			<%else%>
			
			<label>Nombre del evento</label>
			<input name="nombre" type="input"
				<%if @style==:mod%>
				placeholder="<%=@editee.nombre%>"
				<%end%>
				<%= "required" if @style == :alta %>
			>
			<br>
			
			<label>Descripcion</label>
			<input name="descripcion" type="input"
			<%if @style==:mod%>
				placeholder="<%=@editee.descripcion%>"
				<%= "required" if @style == :alta %>
			<%end%>
			>
			<br>
			
			<label>Fecha del evento</label>
			<span style="color:red">*</span>
			<input type="datetime-local"
				id="fechaHora" name="fechaHora"
				<%= "required" if @style == :alta %>
			>
			
			<% end %>
		</ul>
	</div>
	<div class="centermini" style="display: flex;">
		<input type="submit" value="<%=
			case @style
			when :alta; "Crear"
			when :mod; "Modificar"
			when :baja; "Confirmar baja!"
			else "???????????????"
			end
		%>">
	</div>
	</form>
	
	<% if @style == :mod %><%# otros tipos de modificacion (participacion, donaciones) %>
	<br>
	<form
		autocomplete="off"
		method="post"
		action="../donate/<%=@editee.ideventos%>"
	>
	Donaciones<br>
	<div class="centermini" style="display: block;">
		Donaciones realizadas en este evento:
		<ul>
			<% if @editee&.donar&.any? then %>
				<% @editee.donar.each do |donev| %>
				<% don = @donLUT[donev.iddonaciones] %>
				<% raise "DON????" unless don %>
				<li>- <%= "#{don.descripcion} (#{donev.cantidad_donada})" %></li>
				<% end %>
			<% else %>
				<li>Nada.</li>
			<% end %>
		</ul>
		<br>
		<label>Agregar donacion?</label> <select name="itemid" required>
		<% @alldons.each do |don| %>
			<option value=<%=don.iddonaciones%>>
			<%= "#{don.descripcion} (#{don.cantidad})" %>
		<% end %>
		</select>
		<label>Cantidad</label>
		<input name="cantidad" type="number" min="1" required>
	</div>
	<div class="centermini" style="display: flex;">
		<input type="submit" value="Registrar donacion">
	</div>
	</form>
	
	<br>
	<form
		autocomplete="off"
		method="post"
		action="../join/<%=@editee.ideventos%>"
	>
	Participacion<br>
	<div class="centermini" style="display: block;">
		Estos usuarios participan en el evento:
		<ul>
			<% if @editee&.usuario&.any? then %>
				<% @editee.usuario.each do |u| %>
				<li>- <%= "#{u.nombreUsuario}" %></li>
				<% end %>
			<% else %>
				<li><i>Nadie.</i></li>
			<% end %>
		</ul>
		<br>
		<label>Agregar miembro?</label>
			<select name="userid" required>
			<% @allusers.each do |u| %>
			  <option value=<%=u.idusuario%>>
				<%=u.nombreUsuario%><%=" (participando)" if @editee.usuario.include?(u)%>
			<% end %>
			</select>
	</div>
	<div class="centermini" style="display: flex;">
		<input type="submit" value="Asignar/Remover">
	</div>
	</form>
	<% end %>
	
	<% elsif $session.can_join_events? %> <%# para can_mod_events? %>
	
	<form
		autocomplete="off"
		method="post"
		action="../join/<%=@editee.ideventos%>"
	>
	Mi participacion<br>
	<div class="centermini" style="display: block;">
		Estos usuarios participan en el evento:
		<ul>
			<% if @editee&.usuario&.any? then %>
				<% @editee.usuario.each do |u| %>
				<li>- <%= "#{u.nombreUsuario}" %></li>
				<% end %>
			<% else %>
				<li><i>Nadie.</i></li>
			<% end %>
		</ul>
		<br>
		<% alreadyIn = @editee.usuario.include?($session.user) %>
		<label><%= alreadyIn ? "Dejar de participar?" : "Participar?" %></label>
	</div>
	<div class="centermini" style="display: flex;">
		<input type="submit" value="<%= alreadyIn ? "Salir" : "Participar" %>">
	</div>
	</form>
	
	<% end %>
	
	
</body>
</html>