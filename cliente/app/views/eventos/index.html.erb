<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Eventario</title>
	<!-- <link rel="stylesheet" href="stylesheet.css"> -->
</head>
<body>
	
	<%= render "shared/navbar" %>
	
	<%= render "shared/notif" %>
	
	<% unless @badlist %>
	
	<div class="centermini" style="display: flex;">
		<table style="width: 100%; display: table; clear: both;">
		<tr>
			<th></th>
			<th>Nombre</th>
			<th>Descripcion</th>
			<th>Fecha y Hora</th>
			<th>Participantes</th>
		</tr>
		
		<% @items.sort_by(&:first).each do |key, item| %>
		<tr>
			<td>
				<% if $session.logged_in? %>
				
				<a href="/eventos/mod/<%=item.ideventos%>" class="btn"
					<% if $session.can_mod_events? %>title="Modificar"
					<% else %>title="Participacion"<% end %>
					><%= $session.can_mod_events? ? "📋" : "🙋" %></a>
				<a href="/eventos/baja/<%=item.ideventos%>" class="btn"
					title="Eliminar">
    				❌
				</a>
				
				<% end %>
			</td>
			<td><%= item.nombre %></td>
			<td><%= item.descripcion %></td>
			<td><%= item.fechaHora.to_time %></td>
			<td>
				<% item.usuario.each do |uu| %>
				<%# @users[item.usuario_mod].nombreUsuario %>
				<%= uu.nombreUsuario %><br>
				<% end %>
			</td>
		</tr>
		<% end %>
		</table>
	</div>
	<div class="centermini" style="display: flex;">
		<a href="/eventos/alta" class="btn">
			Nuevo
    	</a>
	</div>
	
	<% end %>
	
</body>
</html>