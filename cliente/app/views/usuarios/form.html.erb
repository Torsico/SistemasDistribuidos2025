<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Usuarios</title>
	<!-- <link rel="stylesheet" href="stylesheet.css"> -->
</head>
<body>
	
	<%= render "shared/navbar" %>
	
	<%= render "shared/notif" %>
	
	<form>
	<div class="centermini" style="display: flex;">
		<ul>
			<label for="namein">Nombre</label>
			<input name="namein" type="input"><br>
			<label for="apelin">Apellido</label>
			<input name="apelin" type="input"><br>
		</ul>
	</div>
	<div class="centermini" style="display: flex;">
		<% if @make %>
			<input type="submit" value="Crear">
		<% else %>
			<input type="submit" value="Modificar">
		<% end %>
	</div>
	</form>
	
</body>
</html>