<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Usuarios</title>
	<!-- <link rel="stylesheet" href="stylesheet.css"> -->
</head>
<body>
	
	<%= render "shared/navbar" %>
	
	<%= render "shared/notif" %>
	
	<div>
		<%= @make ? "Creando" : "Editando" %> usuario
	</div>
	
	<form
		autocomplete="off"
		<% if @make %>
			method="post"
			action="alta"
		<% else %>
			method="post"
			action="<%=@editee.idusuario%>"
		<% end %>
	>
	<div class="centermini" style="display: flex;">
		<ul>
			
			<label for="nombreUsuario">Nombre de Usuario</label>
			<span style="color:red"><%= "*" if @make %></span>
			<input name="nombreUsuario" type="input"
				<%= "required" if @make %>
				placeholder="<%= @editee&.nombreUsuario %>">
			<br>
			
			<label for="nombre">Nombre</label>
			<span style="color:red"><%= "*" if @make %></span>
			<input name="nombre" type="input"
				<%= "required" if @make %>
				placeholder="<%= @editee&.nombre %>">
			<br>
			
			<label for="apellido">Apellido</label>
			<span style="color:red"><%= "*" if @make %></span>
			<input name="apellido" type="input"
				<%= "required" if @make %>
				placeholder="<%= @editee&.apellido %>">
			<br>
			
			<label for="telefono">Telefono</label>
			<input name="telefono" type="input"
				placeholder="<%= @editee&.telefono %>">
			<br>
			
			<label for="email">E-mail</label>
			<span style="color:red"><%= "*" if @make %></span>
			<input name="email" id="email" type="input"
				<%= "required" if @make %>
				placeholder="<%= @editee&.email %>">
			<br>
			
			<label for="rol">Rol</label>
			<select name="rol">
				<% for i in 1..4 do %>
					<option value="<%=i%>"
					<%="selected" if @editee&.rol==i || (@editee.nil? && i==1)%>>
						<%= $rolelut[i] %>
					</option>
				<% end %>
			</select>
			<br>
			
			<label for="activo">Activo</label>
			<input name="activo" type="checkbox"
				<%= "checked" if @editee&.activo %>>
			<br>
			
		</ul>
	</div>
	<div class="centermini" style="display: flex;">
		<% if @make %><input type="submit" value="Crear">
		<% else %><input type="submit" value="Modificar">
		<% end %>
	</div>
	</form>
	
</body>
</html>